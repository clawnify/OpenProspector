{
  "name": "open-prospector",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/build-signal-skill.mjs && wrangler d1 execute open-prospector-db --local --file=src/server/schema.sql && concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8789\"",
    "build": "node scripts/build-signal-skill.mjs && vite build",
    "typecheck": "node scripts/build-signal-skill.mjs && tsc --noEmit",
    "test": "node scripts/build-signal-skill.mjs && vitest run",
    "seed": "wrangler d1 execute open-prospector-db --local --file=seed.sql",
    "previews:logos": "node scripts/build-previews.mjs logos",
    "previews:build": "node scripts/build-previews.mjs build",
    "previews:check": "node scripts/build-previews.mjs check",
    "previews:export": "node scripts/build-previews.mjs export"
  },
  "dependencies": {
    "@clawnify/agents": "^0.1.1",
    "@clawnify/app": "^0.2.1",
    "@clawnify/connections": "^0.3.0",
    "@clawnify/db": "^0.4.1",
    "@clawnify/queue": "^0.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.2",
    "hono": "^4.6.0",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@clawnify/logokit": "^0.3.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
